# ==============================================================================
# SMTP Configuration (Nodemailer Contact Service)
# ==============================================================================
# For Gmail, generate an App Password from: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"

# Destination email where contact form submissions will be forwarded
CONTACT_EMAIL="your-destination-email@gmail.com"
